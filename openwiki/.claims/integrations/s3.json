        }
      ]
    },
    {
      "id": "claim_912878039d854da8b064f646f18d6289",
      "statement": "build_sync_command constructs the aws CLI argument vector as ['aws', 's3', 'sync', <local_dir>, config.s3.bucket, '--profile', config.s3.profile] and raises ValueError if config.s3 is None.",
      "evidence": [
        {
          "resource": "repo://transcriber/publish/s3.py#L44-L60",
          "version": "repo-lines-v1:sha256:0c4cf5b9d20b59de504a47e6ff48ec17d641f59a32e44bec7d5b6e01ba00caea:"
        }
      ]
    },
    {
      "id": "claim_a1f9064793694316abae4ad3ff8b3840",
      "statement": "When enabled, sync executes aws s3 sync through duct, polls the child process every 0.1 seconds, and enforces config.timeouts.s3 as a wall-clock deadline using time.monotonic(). It returns True on success.",
      "evidence": [
        {
          "resource": "repo://transcriber/publish/s3.py#L72-L113",
          "version": "repo-lines-v1:sha256:41f8c30fee36a1212f30324177a38479dbb52cc3b4195655abbceb0a0fc2e5c5:"
        }
      ]
    },
    {
      "id": "claim_13a507e509ba4f63a7a7d57d7dd3d469",
      "statement": "S3SyncError is raised when aws s3 sync exits non-zero; S3SyncTimeout (a subclass of S3SyncError) is raised when the upload exceeds the configured timeout, after the child process is killed.",
