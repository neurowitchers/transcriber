  "claims": [
    {
      "id": "claim_419395ccf46246f7ab1f687d4c252dab",
      "statement": "The S3 sync stage is implemented in transcriber/publish/s3.py and uploads a recording directory to an S3 bucket by executing aws s3 sync as a child process through the duct library.",
      "evidence": [
        {
          "resource": "repo://transcriber/publish/s3.py#L1-L20",
          "version": "repo-lines-v1:sha256:1a259acf0cb4c0a0d73c7782cd04a1b527c6b2e906d9e306486429a27980964b:"
        }
      ]
    },
    {
      "id": "claim_984e11aec30b4b1cb91a054d1dee6504",
      "statement": "The S3 stage is gated by two independent conditions: config.stages.s3_sync must be truthy and config.s3 must not be None. The is_enabled function returns True only when both are satisfied.",
      "evidence": [
        {
          "resource": "repo://transcriber/config.py#L130-L133",
          "version": "repo-lines-v1:sha256:d08fab7a7364ccc31d6dd3ca145f0b2ff794c189fe3513548f18851852e4f56a:"
        },
        {
          "resource": "repo://transcriber/config.py#L61-L65",
          "version": "repo-lines-v1:sha256:ffc38090afd301764bf321def079bfae669ea6485cbdad2ec74e8ceb3c81774c:"
        },
        {
          "resource": "repo://transcriber/publish/s3.py#L63-L69",
