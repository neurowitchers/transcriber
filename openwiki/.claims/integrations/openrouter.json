    {
      "id": "claim_20e0ab852cb54bcfa46674562ef0465b",
      "statement": "The OpenRouter slides backend enforces deterministic ceilings before any HTTP call: a max slide count (`MAX_SLIDES` default 60, overridable via `openrouter.max_slides`) and a whole-deck encoded-byte ceiling (`MAX_TOTAL_ENCODED_BYTES` = 48 MiB) checked once up front by `_preflight_deck_encoded_bytes`; over-ceiling decks hard-fail without chunking.",
      "evidence": [
        {
          "resource": "repo://transcriber/backends/slides.py#L350-L415",
          "version": "repo-lines-v1:sha256:3ecded7f58be0abfdbdd55679a505918d55af6e4ff36785410b408b7261b20b8:"
