    {
      "id": "claim_70ee51a5e8124996a75557dd316e3266",
      "statement": "The transcriber has two OpenRouter HTTP seams: an OpenAI-format `/audio/transcriptions` STT seam that posts a JSON base64 audio body and a shared `/chat/completions` vision helper used by the slides backend; both resolve the API key at use time and attach public attribution headers.",
      "evidence": [
        {
          "resource": "repo://transcriber/backends/openrouter.py#L67-L180",
          "version": "repo-lines-v1:sha256:8ffc74f11473f89e1646fc9b73dbd3fc73ec35b3985d64b8f79ae9c3c6e96e1f:"
