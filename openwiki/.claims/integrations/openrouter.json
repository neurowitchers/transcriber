  "claims": [
    {
      "id": "claim_e79bdd5483cc4980b1628e309709bc07",
      "statement": "The transcriber treats the `openrouter` config section as unconditionally required because it is the transcription backend (OpenRouter STT) in addition to earlier slides/agno triggers; a config without it raises `ConfigError` at load time.",
      "evidence": [
        {
          "resource": "repo://transcriber/config.py#L275-L284",
          "version": "repo-lines-v1:sha256:26a889123ff3bbf4825a5ecc85cbb3240eb2fb74436ddcd5da702383db8cd647:"
        }
      ]
    },
    {
      "id": "claim_ce1129ff209049789522ebc01e0f3858",
      "statement": "OpenRouter STT model selection (`transcribe.model_id`) is separate from OpenRouter vision/summary model selection (`openrouter.slides_model`, `openrouter.summary_model`); the config model keeps them in different blocks and different stages.",
      "evidence": [
        {
          "resource": "repo://transcriber/config.py#L56-L62",
          "version": "repo-lines-v1:sha256:6226c6087dba8b11cf135e784d33ef032a28046f53e6317b47427bfa34f695c9:"
