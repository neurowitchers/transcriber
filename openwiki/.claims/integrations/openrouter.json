        }
      ]
    },
    {
      "id": "claim_6db15fe596c349b884204181142be541",
      "statement": "The OpenRouter API key is referenced by environment-variable name only in config and resolved at use time by `transcriber.config.resolve_env`; the resolved value is never stored in the config model.",
