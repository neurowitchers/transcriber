    {
      "id": "claim_e7db0c40406a4f8fa0a6c43a78f81800",
      "statement": "The shared OpenRouter chat seam is `_openrouter_chat(config, messages, model, *, timeout, error_cls, missing_config_message)`: it POSTs `{base_url}/chat/completions`, resolves the Bearer key at use time via `resolve_env`, reads `choices[0].message.content` directly to avoid SDK truncation of reasoning-model output, and raises the caller-supplied error type on failure.",
      "evidence": [
