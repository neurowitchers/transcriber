  "claims": [
    {
      "id": "claim_e79bdd5483cc4980b1628e309709bc07",
      "statement": "The transcriber's config loader treats the `openrouter` section as unconditionally required: although the `Config.openrouter` dataclass field is typed `Optional[OpenRouter]`, `_from_dict` hard-fails with a `ConfigError` when the mapping is absent, because `openrouter` is the transcription backend (OpenRouter STT) in addition to the slides/agno triggers.",
      "evidence": [
        {
          "resource": "repo://transcriber/config.py#L302-L311",
          "version": "repo-lines-v1:sha256:26a889123ff3bbf4825a5ecc85cbb3240eb2fb74436ddcd5da702383db8cd647:"
        }
      ]
    },
    {
      "id": "claim_ce1129ff209049789522ebc01e0f3858",
      "statement": "OpenRouter STT model selection (`transcribe.model_id`) is separate from OpenRouter vision/summary model selection (`openrouter.slides_model`, `openrouter.summary_model`); the config model keeps them in different blocks used by different stages.",
      "evidence": [
        {
          "resource": "repo://transcriber/backends/slides.py",
          "version": "repo-file-v1:sha256:48a05be4e0e55ebe82b10b388a2e99c6fdb99097e16dbff2ff832e029d19dc84"
