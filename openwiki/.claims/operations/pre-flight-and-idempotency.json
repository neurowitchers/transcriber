    {
      "id": "claim_3cd6a151ddcf486ebd4b8a98b9fdf016",
      "statement": "The orchestrator _process_one runs each stage in order and consults the manifest before acting, with per-stage skip rules: pipeline skips when complete; describe_slides skips when disabled, already complete, or artifact present (idempotent, no paid call); summarize+notion skips when both complete; telegram skips when complete; s3 skips when disabled or complete; cleanup skips when keep_intermediates or complete.",
      "evidence": [
        {
          "resource": "repo://transcriber/__main__.py#L290-L419",
          "version": "repo-lines-v1:sha256:0c0979fd00cd13757110a723166aabd4f7a5a5bbdf87149d839168b508949874:"
        }
